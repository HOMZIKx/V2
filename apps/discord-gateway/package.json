    "generate:banner": "node ./scripts/generate-banner.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-fastify": "^11.1.28",
    "@v2/configuration": "workspace:*",
    "@v2/hub-core": "workspace:*",
    "@v2/messaging": "workspace:*",
    "@v2/observability": "workspace:*",
    "discord.js": "14.25.1",
    "jose": "6.2.8",
    "fastify": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.2.0",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
