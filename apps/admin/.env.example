# New Bot (discord-gateway) base URL for Technician Status / Diagnostyka
# Used by Vite as VITE_DISCORD_GATEWAY_BASE_URL (GET /health/live, /health/ready, /health/discord).
VITE_DISCORD_GATEWAY_BASE_URL=http://127.0.0.1:4100

# Optional activity-service admin READ (guild catalogs / config). Technician only — no secrets.
# When both are set, Konfiguracja bota can GET guild config catalogs. Never write/apply from Admin;
# Discord apply/rollback is owned by New Bot after OpenAPI ships.
# VITE_ACTIVITY_ADMIN_BASE_URL=http://127.0.0.1:3200
# VITE_ACTIVITY_ADMIN_GUILD_ID=

# --- Expected API paths (documentation for Technicians / New Bot) ---
# Gateway health (LIVE today):
#   GET  {VITE_DISCORD_GATEWAY_BASE_URL}/health/live
#   GET  {VITE_DISCORD_GATEWAY_BASE_URL}/health/ready
#   GET  {VITE_DISCORD_GATEWAY_BASE_URL}/health/discord
#
# New Bot Discord config OpenAPI (NOT live yet — do not enable decorative apply UI):
#   GET  {gateway}/discord/v1/capabilities
#   GET  {gateway}/discord/v1/config
#   PUT  {gateway}/discord/v1/config
#   POST {gateway}/discord/v1/config/apply
#   POST {gateway}/discord/v1/config/rollback
#   GET  {gateway}/discord/v1/config/active-revision
#
# activity-admin READ (optional when VITE_ACTIVITY_ADMIN_* set):
#   GET  {base}/activity/v1/admin/guilds/:guildId/config
#   GET  {base}/activity/v1/admin/guilds/:guildId/types
#   GET  {base}/activity/v1/admin/guilds/:guildId/statuses
#   GET  {base}/activity/v1/admin/guilds/:guildId/participant-fields
#   GET  {base}/activity/v1/admin/guilds/:guildId/channels
#   GET  {base}/activity/v1/admin/guilds/:guildId/ping-roles
#   GET  {base}/activity/v1/admin/guilds/:guildId/report-reasons
#   GET  {base}/activity/v1/admin/guilds/:guildId/audit

# Live-config keys expected inside PUT /discord/v1/config (New Bot OpenAPI — not live yet):
#   timersDiscordNotify: { enabled, messageTemplate, reminderMinutesBefore }
#   kingdomWarPw: { enabled, warAt (HH:MM Europe/Warsaw, default 18:00), notifyMinutesBefore (default 30 → 17:30), messageTemplate }
# Never put DISCORD_NOTIFY_SHARED_SECRET, bot tokens, OAuth secrets, or DB URLs in Admin Vite env.
