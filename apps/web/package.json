{
  "name": "@v2/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./run-next.mjs dev --hostname 127.0.0.1 --port 3000",
    "build": "node ./run-next.mjs build",
    "start": "node ./run-next.mjs start",
    "start:local": "node ./run-next.mjs start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "e2e": "playwright test --config playwright.config.ts"
  },
  "dependencies": {
    "@v2/design-system": "workspace:*",
    "@v2/hub-core": "workspace:*",
    "next": "15.5.22",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  }
}
