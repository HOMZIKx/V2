# Production image for @v2/discord-gateway (Nest + Fastify).
# Build: docker build -f Dockerfile.discord-gateway -t v2-discord-gateway .
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration/package.json ./packages/configuration/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY apps/discord-gateway/package.json ./apps/discord-gateway/package.json
RUN pnpm install --frozen-lockfile --filter @v2/discord-gateway...

FROM deps AS build
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration ./packages/configuration
COPY packages/observability ./packages/observability
COPY apps/discord-gateway ./apps/discord-gateway
COPY infrastructure/docker/point-workspace-exports-to-dist.mjs ./infrastructure/docker/point-workspace-exports-to-dist.mjs
RUN pnpm --filter @v2/configuration run build \
  && pnpm --filter @v2/observability run build \
  && node infrastructure/docker/point-workspace-exports-to-dist.mjs packages/configuration packages/observability \
  && rm -rf packages/configuration/src packages/observability/src \
  && pnpm --filter @v2/discord-gateway run build

FROM base AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4100
ENV DISCORD_GATEWAY_HOST=0.0.0.0
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/packages/typescript-config ./packages/typescript-config
COPY --from=build /app/packages/configuration/package.json ./packages/configuration/package.json
COPY --from=build /app/packages/configuration/dist ./packages/configuration/dist
COPY --from=build /app/packages/observability/package.json ./packages/observability/package.json
COPY --from=build /app/packages/observability/dist ./packages/observability/dist
COPY --from=build /app/apps/discord-gateway/package.json ./apps/discord-gateway/package.json
COPY --from=build /app/apps/discord-gateway/dist ./apps/discord-gateway/dist
COPY --from=build /app/apps/discord-gateway/assets ./apps/discord-gateway/assets
RUN pnpm install --frozen-lockfile --prod --filter @v2/discord-gateway...
WORKDIR /app/apps/discord-gateway
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4100)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/apps/discord-gateway/src/main.js"]
