# Production image for @v2/discord-gateway (Nest + Fastify).
# Build: docker build -f Dockerfile.discord-gateway -t v2-discord-gateway .
FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration/package.json ./packages/configuration/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY packages/messaging/package.json ./packages/messaging/package.json
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY packages/hub-core/package.json ./packages/hub-core/package.json
COPY packages/notification-core/package.json ./packages/notification-core/package.json
COPY apps/discord-gateway/package.json ./apps/discord-gateway/package.json
RUN pnpm install --frozen-lockfile --filter @v2/discord-gateway...

FROM deps AS build
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration ./packages/configuration
COPY packages/observability ./packages/observability
COPY packages/messaging ./packages/messaging
COPY packages/contracts ./packages/contracts
COPY packages/hub-core ./packages/hub-core
COPY packages/notification-core ./packages/notification-core
COPY apps/discord-gateway ./apps/discord-gateway
COPY infrastructure/docker/point-workspace-exports-to-dist.mjs ./infrastructure/docker/point-workspace-exports-to-dist.mjs
RUN pnpm --filter @v2/configuration run build \
  && pnpm --filter @v2/observability run build \
  && pnpm --filter @v2/messaging run build \
  && pnpm --filter @v2/contracts run build \
  && pnpm --filter @v2/hub-core run build \
  && pnpm --filter @v2/notification-core run build \
  && node infrastructure/docker/point-workspace-exports-to-dist.mjs packages/configuration packages/observability packages/messaging packages/contracts packages/hub-core packages/notification-core \
  && rm -rf packages/configuration/src packages/observability/src packages/messaging/src packages/contracts/src packages/hub-core/src packages/notification-core/src \
  && pnpm --filter @v2/discord-gateway run build

FROM base AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4100
ENV DISCORD_GATEWAY_HOST=0.0.0.0
# Zeabur injects ZEABUR_GIT_COMMIT_SHA at Git image build (no empty ARG default).
ARG ZEABUR_GIT_COMMIT_SHA
ENV V2_IMAGE_GIT_COMMIT_SHA=$ZEABUR_GIT_COMMIT_SHA
WORKDIR /app
COPY --from=build /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/packages/typescript-config ./packages/typescript-config
COPY --from=build /app/packages/configuration/package.json ./packages/configuration/package.json
COPY --from=build /app/packages/configuration/dist ./packages/configuration/dist
COPY --from=build /app/packages/observability/package.json ./packages/observability/package.json
COPY --from=build /app/packages/observability/dist ./packages/observability/dist
COPY --from=build /app/packages/messaging/package.json ./packages/messaging/package.json
COPY --from=build /app/packages/messaging/dist ./packages/messaging/dist
COPY --from=build /app/packages/contracts/package.json ./packages/contracts/package.json
COPY --from=build /app/packages/contracts/dist ./packages/contracts/dist
COPY --from=build /app/packages/hub-core/package.json ./packages/hub-core/package.json
COPY --from=build /app/packages/hub-core/dist ./packages/hub-core/dist
COPY --from=build /app/packages/notification-core/package.json ./packages/notification-core/package.json
COPY --from=build /app/packages/notification-core/dist ./packages/notification-core/dist
COPY --from=build /app/apps/discord-gateway/package.json ./apps/discord-gateway/package.json
COPY --from=build /app/apps/discord-gateway/dist ./apps/discord-gateway/dist
COPY --from=build /app/apps/discord-gateway/assets ./apps/discord-gateway/assets
RUN pnpm install --frozen-lockfile --prod --filter @v2/discord-gateway...
WORKDIR /app/apps/discord-gateway
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4100)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "dist/apps/discord-gateway/src/main.js"]
