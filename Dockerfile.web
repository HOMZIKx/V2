FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/design-system/package.json ./packages/design-system/package.json
COPY packages/hub-core/package.json ./packages/hub-core/package.json
COPY apps/web/package.json ./apps/web/package.json
RUN pnpm install --frozen-lockfile --filter @v2/web...

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/design-system ./packages/design-system
COPY packages/hub-core ./packages/hub-core
COPY apps/web ./apps/web
COPY tools/runtime/public-origin.mjs ./tools/runtime/public-origin.mjs
# Zeabur injects service variables into the build environment. Do not declare
# `ARG VAR=` defaults — they overwrite those values with empty strings.
ARG NEXT_PUBLIC_API_BASE_URL
ARG NEXT_PUBLIC_IDENTITY_URL
ARG NEXT_PUBLIC_WEB_ORIGIN
ARG NEXT_PUBLIC_WEB_GUILDS
ARG NEXT_PUBLIC_DISCORD_TEST_GUILD_ID
ARG GIT_COMMIT_SHA
ARG NEXT_PUBLIC_GIT_COMMIT_SHA
ARG ZEABUR_GIT_COMMIT_SHA
RUN node --input-type=module -e "import { evaluatePublicOrigin } from './tools/runtime/public-origin.mjs'; const keys=['NEXT_PUBLIC_API_BASE_URL','NEXT_PUBLIC_IDENTITY_URL','NEXT_PUBLIC_WEB_ORIGIN']; for (const key of keys) { const result=evaluatePublicOrigin(process.env[key],{requireHttps:true}); if(!result.ok){ console.error(key+' must be a public https origin at image build ('+result.reason+')'); process.exit(1);} }"
RUN sh -c 'sha="${GIT_COMMIT_SHA:-${ZEABUR_GIT_COMMIT_SHA:-$NEXT_PUBLIC_GIT_COMMIT_SHA}}"; if [ -n "$sha" ]; then export NEXT_PUBLIC_GIT_COMMIT_SHA="$sha"; export GIT_COMMIT_SHA="$sha"; fi; if [ -n "$NEXT_PUBLIC_WEB_GUILDS" ]; then export NEXT_PUBLIC_WEB_GUILDS="$NEXT_PUBLIC_WEB_GUILDS"; fi; if [ -n "$NEXT_PUBLIC_DISCORD_TEST_GUILD_ID" ]; then export NEXT_PUBLIC_DISCORD_TEST_GUILD_ID="$NEXT_PUBLIC_DISCORD_TEST_GUILD_ID"; fi; pnpm --filter @v2/web build'

FROM base AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3000
ARG ZEABUR_GIT_COMMIT_SHA
ENV V2_IMAGE_GIT_COMMIT_SHA=$ZEABUR_GIT_COMMIT_SHA
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --from=deps /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/apps/web ./apps/web
EXPOSE 3000
WORKDIR /app/apps/web
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "pnpm exec next start --hostname 0.0.0.0 --port ${PORT:-3000}"]
