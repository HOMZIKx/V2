# Environment example — no real secrets
# Copy to .env for local overrides if needed. Apps read validated config only.

NODE_ENV=development

# --- Web / Admin ---
WEB_PORT=3000
ADMIN_PORT=3001
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# --- API Gateway ---
API_GATEWAY_PORT=4000
API_GATEWAY_HOST=127.0.0.1

# --- Discord Gateway ---
DISCORD_GATEWAY_PORT=4100
DISCORD_GATEWAY_HOST=127.0.0.1

# P1 test harness — keep DISCORD_ENABLED=false for CI and tokenless dev.
# Live setup: docs/discord/TEST_BOT_SETUP.md
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_TOKEN=
DISCORD_TEST_GUILD_ID=1534228693017432124
DISCORD_TEST_OPERATOR_IDS=
DISCORD_COMPONENT_SIGNING_SECRET=
DISCORD_AUTO_REGISTER_GUILD_COMMANDS=false
DISCORD_STRICT_GUILD_ISOLATION=true
# Optional: channel snowflake for doctor permission probe
DISCORD_TEST_CHANNEL_ID=

# Discord Gateway -> Authorization membership sync (P3-D1 / P3-D20).
# Keep false for CI / P1 harness. When true, Gateway posts register/events/reconcile
# with Authorization-Client-Assertion (client v2.discord-gateway).
DISCORD_AUTHORIZATION_SYNC_ENABLED=false
AUTHORIZATION_BASE_URL=http://127.0.0.1:4300
# Prefer shared aud matching AUTHORIZATION_ASSERTION_AUD on Authz; if empty, per-path aud is used.
# AUTHORIZATION_ASSERTION_AUD is defined under Authorization Service below.
DISCORD_TO_AUTHZ_CLIENT_ID=v2.discord-gateway
DISCORD_TO_AUTHZ_PRIVATE_KEY_PEM=
DISCORD_TO_AUTHZ_ACTIVE_KID=
DISCORD_CLIENT_ASSERTION_MAX_TTL_SECONDS=60

# --- Identity Service ---
IDENTITY_SERVICE_PORT=4200
IDENTITY_SERVICE_HOST=127.0.0.1
IDENTITY_DATABASE_URL=postgresql://identity:identity_dev_password@127.0.0.1:5432/identity

# Identity / Better Auth (P2 proof slice).
# Keep IDENTITY_AUTH_ENABLED=false for CI and tokenless dev (health still works).
# Live OAuth setup: docs/identity/LOCAL_OAUTH_PROOF.md. Never commit real secrets.
IDENTITY_AUTH_ENABLED=false
IDENTITY_REDIS_URL=redis://127.0.0.1:6379/1
IDENTITY_AUTH_BASE_URL=http://127.0.0.1:4200
IDENTITY_AUTH_BASE_PATH=/api/auth
IDENTITY_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IDENTITY_COOKIE_PREFIX=v2.identity
IDENTITY_PROOF_UI_ENABLED=false
# Minimum 32 characters when IDENTITY_AUTH_ENABLED=true.
IDENTITY_BETTER_AUTH_SECRET=
IDENTITY_DISCORD_CLIENT_ID=
IDENTITY_DISCORD_CLIENT_SECRET=
# Second OAuth provider deferred — P2 active scope is Discord only.

# Internal service-to-service JWT (P2 — Issue #13).
# Requires IDENTITY_AUTH_ENABLED=true. See docs/identity/INTERNAL_JWT.md.
IDENTITY_INTERNAL_JWT_ENABLED=false
IDENTITY_INTERNAL_JWT_ISSUER=http://127.0.0.1:4200
IDENTITY_INTERNAL_JWT_TTL_SECONDS=300
IDENTITY_INTERNAL_JWT_ISSUE_URL=http://127.0.0.1:4200/identity/internal-token
IDENTITY_INTERNAL_JWT_ACTIVE_KID=
IDENTITY_INTERNAL_JWT_KEYRING_JSON=
IDENTITY_SERVICE_CLIENTS_JSON=
IDENTITY_CLIENT_ASSERTION_MAX_TTL_SECONDS=60
IDENTITY_CLIENT_ASSERTION_CLOCK_SKEW_SECONDS=60
IDENTITY_CLIENT_ASSERTION_REDIS_PREFIX=v2:identity:client-assertion:jti:
# Exact aud for Authz→Identity system revoke (no user cookie).
IDENTITY_SYSTEM_REVOKE_URL=http://127.0.0.1:4200/identity/v1/system/revoke-sessions
# Example IDENTITY_SERVICE_CLIENTS_JSON entry for Authz (public keys only; no PEMs in this file):
# [{"client_id":"v2.api-gateway","allowed_audiences":["v2.api-gateway"],"keys":[...]},
#  {"client_id":"v2.authorization-service","allowed_audiences":["http://127.0.0.1:4200/identity/v1/system/revoke-sessions"],"keys":[...]}]

# Identity → Authorization login entitlement gate (P3-D19).
# Keep false for CI / existing Identity tests. When true, Discord OAuth session
# creation calls Authz identity-links + authorize before persisting the session.
IDENTITY_AUTHORIZATION_ENABLED=false
IDENTITY_AUTHORIZATION_BASE_URL=http://127.0.0.1:4300
IDENTITY_AUTHORIZATION_ASSERTION_AUD=http://127.0.0.1:4300/authorization/v1
IDENTITY_TO_AUTHZ_CLIENT_ID=v2.identity-service
IDENTITY_TO_AUTHZ_PRIVATE_KEY_PEM=
IDENTITY_TO_AUTHZ_ACTIVE_KID=

# --- API Gateway internal JWT client (server-only; no browser exposure) ---
INTERNAL_JWT_CLIENT_ENABLED=false
INTERNAL_JWT_CLIENT_ID=v2.api-gateway
INTERNAL_JWT_CLIENT_PRIVATE_KEY_PEM=
INTERNAL_JWT_CLIENT_ACTIVE_KID=
INTERNAL_JWT_ASSERTION_AUD=http://127.0.0.1:4200/identity/internal-token
INTERNAL_JWT_IDENTITY_BASE_URL=http://127.0.0.1:4200
INTERNAL_JWT_JWKS_URL=http://127.0.0.1:4200/identity/.well-known/jwks.json
INTERNAL_JWT_ISSUER=http://127.0.0.1:4200
INTERNAL_JWT_DEFAULT_AUDIENCE=v2.api-gateway

# --- Authorization Service ---
AUTHORIZATION_SERVICE_PORT=4300
AUTHORIZATION_SERVICE_HOST=127.0.0.1
AUTHORIZATION_DATABASE_URL=postgresql://authorization:authorization_dev_password@127.0.0.1:5432/authorization
# Keep AUTHORIZATION_ENABLED=false for CI / tokenless dev (health still works).
AUTHORIZATION_ENABLED=false
AUTHORIZATION_TRUST_WINDOW_SECONDS=120
# Required when AUTHORIZATION_ENABLED=true: the exact Discord user id allowed to
# become organization owner on first bootstrap. Ownership never transfers if this
# later changes.
AUTHORIZATION_BOOTSTRAP_DISCORD_USER_ID=
AUTHORIZATION_ORGANIZATION_ID=
# JSON array of inbound S2S clients. Each entry is
# { "client_id", "keys": [{ "kid", "status", "public_key_pem" }],
#   "allowed_operations": [...] }. allowed_operations is a per-client allowlist of
# operations (deny-by-default when omitted), e.g.:
#   identity-service: ["identity_link","authorize"]
#   discord-gateway:  ["discord_register","discord_events","discord_reconcile"]
#   policy/operator:  ["bootstrap","activate_guild","set_login_entitling","grants","blocks","process_expirations"]
AUTHORIZATION_INBOUND_CLIENTS_JSON=
# Include v2.discord-gateway public keys (with allowed_operations) when Discord sync is enabled.
AUTHORIZATION_SYSTEM_CLIENT_ID=v2.authorization-service
AUTHORIZATION_SYSTEM_ACTIVE_KID=
AUTHORIZATION_SYSTEM_PRIVATE_KEY_PEM=
AUTHORIZATION_IDENTITY_BASE_URL=http://127.0.0.1:4200
AUTHORIZATION_IDENTITY_REVOKE_URL=http://127.0.0.1:4200/identity/v1/system/revoke-sessions
AUTHORIZATION_IDENTITY_ASSERTION_MAX_TTL_SECONDS=60
AUTHORIZATION_ASSERTION_AUD=http://127.0.0.1:4300/authorization/v1
AUTHORIZATION_ASSERTION_REDIS_URL=redis://127.0.0.1:6379/2
AUTHORIZATION_ASSERTION_REDIS_PREFIX=v2:authorization:client-assertion:jti:

# --- Activity Service (P4.1) ---
ACTIVITY_SERVICE_PORT=4400
ACTIVITY_SERVICE_HOST=127.0.0.1
ACTIVITY_DATABASE_URL=postgresql://activity:activity_dev_password@127.0.0.1:5432/activity
# Keep ACTIVITY_ENABLED=false for CI / tokenless local (Authz client becomes allow-all stub).
ACTIVITY_ENABLED=false
ACTIVITY_OUTBOX_WORKER_ENABLED=false
ACTIVITY_AUTHORIZATION_BASE_URL=http://127.0.0.1:4300
ACTIVITY_AUTHORIZATION_ASSERTION_AUD=http://127.0.0.1:4300/authorization/v1
ACTIVITY_TO_AUTHZ_CLIENT_ID=v2.activity-service
ACTIVITY_TO_AUTHZ_ACTIVE_KID=
ACTIVITY_TO_AUTHZ_PRIVATE_KEY_PEM=
ACTIVITY_CLIENT_ASSERTION_MAX_TTL_SECONDS=60
# Optional inbound clients (discord-gateway later). Deny-by-default when ACTIVITY_ENABLED=true.
ACTIVITY_INBOUND_CLIENTS_JSON=
ACTIVITY_ASSERTION_AUD=http://127.0.0.1:4400/activity/v1

# --- Shared local infrastructure ---
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
RABBITMQ_URL=amqp://v2:v2_dev_password@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Fail-fast production guard: never point local tools at production
ALLOW_PRODUCTION_CONNECTIONS=false

# Bind to 0.0.0.0 only when a container or deployment explicitly requires it.
