# Environment example — no real secrets
# Copy to .env for local overrides if needed. Apps read validated config only.

NODE_ENV=development

# --- Web / Admin ---
WEB_PORT=3000
ADMIN_PORT=3001
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# --- API Gateway ---
API_GATEWAY_PORT=4000
API_GATEWAY_HOST=127.0.0.1

# --- Discord Gateway ---
DISCORD_GATEWAY_PORT=4100
DISCORD_GATEWAY_HOST=127.0.0.1

# P1 test harness — keep DISCORD_ENABLED=false for CI and tokenless dev.
# Live setup: docs/discord/TEST_BOT_SETUP.md
DISCORD_ENABLED=false
DISCORD_APPLICATION_ID=
DISCORD_TOKEN=
DISCORD_TEST_GUILD_ID=1534228693017432124
DISCORD_TEST_OPERATOR_IDS=
DISCORD_COMPONENT_SIGNING_SECRET=
DISCORD_AUTO_REGISTER_GUILD_COMMANDS=false
DISCORD_STRICT_GUILD_ISOLATION=true
# Optional: channel snowflake for doctor permission probe
DISCORD_TEST_CHANNEL_ID=

# --- Identity Service ---
IDENTITY_SERVICE_PORT=4200
IDENTITY_SERVICE_HOST=127.0.0.1
IDENTITY_DATABASE_URL=postgresql://identity:identity_dev_password@127.0.0.1:5432/identity

# Identity / Better Auth (P2 proof slice).
# Keep IDENTITY_AUTH_ENABLED=false for CI and tokenless dev (health still works).
# Live OAuth setup: docs/identity/LOCAL_OAUTH_PROOF.md. Never commit real secrets.
IDENTITY_AUTH_ENABLED=false
IDENTITY_REDIS_URL=redis://127.0.0.1:6379/1
IDENTITY_AUTH_BASE_URL=http://127.0.0.1:4200
IDENTITY_AUTH_BASE_PATH=/api/auth
IDENTITY_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
IDENTITY_COOKIE_PREFIX=v2.identity
IDENTITY_PROOF_UI_ENABLED=false
# Minimum 32 characters when IDENTITY_AUTH_ENABLED=true.
IDENTITY_BETTER_AUTH_SECRET=
IDENTITY_DISCORD_CLIENT_ID=
IDENTITY_DISCORD_CLIENT_SECRET=
IDENTITY_GOOGLE_CLIENT_ID=
IDENTITY_GOOGLE_CLIENT_SECRET=

# --- Authorization Service ---
AUTHORIZATION_SERVICE_PORT=4300
AUTHORIZATION_SERVICE_HOST=127.0.0.1
AUTHORIZATION_DATABASE_URL=postgresql://authorization:authorization_dev_password@127.0.0.1:5432/authorization

# --- Shared local infrastructure ---
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
RABBITMQ_URL=amqp://v2:v2_dev_password@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Fail-fast production guard: never point local tools at production
ALLOW_PRODUCTION_CONNECTIONS=false

# Bind to 0.0.0.0 only when a container or deployment explicitly requires it.
