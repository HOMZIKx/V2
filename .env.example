# Environment example — no real secrets
# Copy to .env for local overrides if needed. Apps read validated config only.

NODE_ENV=development

# --- Web / Admin ---
WEB_PORT=3000
ADMIN_PORT=3001
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3001

# --- API Gateway ---
API_GATEWAY_PORT=4000
API_GATEWAY_HOST=127.0.0.1

# --- Discord Gateway (no real Discord token required in Prompt 0) ---
DISCORD_GATEWAY_PORT=4100
DISCORD_GATEWAY_HOST=127.0.0.1
DISCORD_TOKEN=

# --- Identity Service ---
IDENTITY_SERVICE_PORT=4200
IDENTITY_SERVICE_HOST=127.0.0.1
IDENTITY_DATABASE_URL=postgresql://identity:identity_dev_password@127.0.0.1:5432/identity

# --- Authorization Service ---
AUTHORIZATION_SERVICE_PORT=4300
AUTHORIZATION_SERVICE_HOST=127.0.0.1
AUTHORIZATION_DATABASE_URL=postgresql://authorization:authorization_dev_password@127.0.0.1:5432/authorization

# --- Shared local infrastructure ---
POSTGRES_PORT=5432
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
RABBITMQ_URL=amqp://v2:v2_dev_password@localhost:5672
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Fail-fast production guard: never point local tools at production
ALLOW_PRODUCTION_CONNECTIONS=false

# Bind to 0.0.0.0 only when a container or deployment explicitly requires it.
