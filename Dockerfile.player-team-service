FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration/package.json ./packages/configuration/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY services/player-team-service/package.json ./services/player-team-service/package.json
RUN pnpm install --frozen-lockfile --filter @v2/player-team-service...

FROM deps AS runtime
COPY packages/configuration ./packages/configuration
COPY packages/observability ./packages/observability
COPY packages/typescript-config ./packages/typescript-config
COPY services/player-team-service ./services/player-team-service
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4400
EXPOSE 4400
WORKDIR /app
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4400)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "pnpm --filter @v2/player-team-service migrate && pnpm --filter @v2/player-team-service exec tsx --tsconfig tsconfig.json src/main.ts"]
