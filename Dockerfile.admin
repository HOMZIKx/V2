FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/design-system/package.json ./packages/design-system/package.json
COPY apps/admin/package.json ./apps/admin/package.json
RUN pnpm install --frozen-lockfile --filter @v2/admin...

FROM deps AS build
COPY tsconfig.base.json ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/design-system ./packages/design-system
COPY apps/admin ./apps/admin
# Zeabur injects service variables into the build environment. Do not declare
# `ARG VAR=` defaults — they overwrite those values with empty strings and bake
# a blank Vite origin. Local image builds must pass --build-arg (no empty default).
ARG VITE_API_BASE_URL
ARG GIT_COMMIT_SHA
ARG VITE_GIT_COMMIT_SHA
ARG VITE_ADMIN_DEV_ACTOR_DISCORD_ID
ARG VITE_ADMIN_DEV_GUILDS
ARG VITE_ADMIN_DEV_ORG_ID
# Local image builds must export VITE_API_BASE_URL first.
RUN node -e "const fs=require('fs'); const e=process.env; const url=(e.VITE_API_BASE_URL||'').trim(); if(!url.startsWith('http')){ console.error('VITE_API_BASE_URL must be a public http(s) origin at image build'); process.exit(1);} const sha=(e.GIT_COMMIT_SHA||e.VITE_GIT_COMMIT_SHA||'').trim(); fs.writeFileSync('/app/.env', ['VITE_API_BASE_URL='+url,'VITE_GIT_COMMIT_SHA='+sha,'VITE_ADMIN_DEV_ACTOR_DISCORD_ID='+(e.VITE_ADMIN_DEV_ACTOR_DISCORD_ID||''),'VITE_ADMIN_DEV_GUILDS='+(e.VITE_ADMIN_DEV_GUILDS||''),'VITE_ADMIN_DEV_ORG_ID='+(e.VITE_ADMIN_DEV_ORG_ID||'')].join('\\n')+'\\n')"
RUN pnpm --filter @v2/admin build

FROM base AS runtime
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=3001
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/admin/node_modules ./apps/admin/node_modules
COPY --from=deps /app/packages/design-system/node_modules ./packages/design-system/node_modules
COPY --from=deps /app/package.json /app/pnpm-lock.yaml /app/pnpm-workspace.yaml ./
COPY --from=build /app/apps/admin ./apps/admin
COPY --from=build /app/packages/design-system ./packages/design-system
EXPOSE 3001
WORKDIR /app/apps/admin
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3001)+'/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["sh", "-c", "pnpm exec vite preview --host 0.0.0.0 --port ${PORT:-3001}"]
