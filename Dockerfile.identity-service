FROM node:24-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && corepack prepare pnpm@10.14.0 --activate

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/typescript-config ./packages/typescript-config
COPY packages/configuration/package.json ./packages/configuration/package.json
COPY packages/observability/package.json ./packages/observability/package.json
COPY services/identity-service/package.json ./services/identity-service/package.json
RUN pnpm install --frozen-lockfile --filter @v2/identity-service...

FROM deps AS runtime
COPY packages/configuration ./packages/configuration
COPY packages/observability ./packages/observability
COPY packages/typescript-config ./packages/typescript-config
COPY services/identity-service ./services/identity-service
ENV NODE_ENV=production
ENV HOST=0.0.0.0
ENV PORT=4200
EXPOSE 4200
WORKDIR /app
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4200)+'/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["pnpm", "--filter", "@v2/identity-service", "exec", "tsx", "src/main.ts"]
