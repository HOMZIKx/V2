{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v2.local/tools/runtime/service-registry.schema.json",
  "title": "V2 deployable service registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "addons", "services"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "description": { "type": "string" },
    "addons": {
      "type": "array",
      "items": { "$ref": "#/$defs/addon" }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "kind", "public"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "ADDON" },
        "kind": { "enum": ["postgres", "redis"] },
        "public": { "type": "boolean" },
        "notes": { "type": "string" },
        "logicalAliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "dockerfile",
        "zbpackDockerfileName",
        "rootDirectory",
        "health",
        "public",
        "dependencies",
        "buildTimeVarNames"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "type": { "const": "APP" },
        "dockerfile": {
          "type": "string",
          "pattern": "^Dockerfile\\.[a-z0-9-]+$"
        },
        "zbpackDockerfileName": {
          "type": "string",
          "pattern": "^[a-z0-9-]+$"
        },
        "rootDirectory": { "const": "/" },
        "health": {
          "type": "object",
          "additionalProperties": false,
          "required": ["live"],
          "properties": {
            "live": { "$ref": "#/$defs/healthPath" },
            "ready": { "$ref": "#/$defs/healthPath" },
            "discord": { "$ref": "#/$defs/healthPath" }
          }
        },
        "public": { "type": "boolean" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "buildTimeVarNames": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "healthPath": {
      "type": "string",
      "pattern": "^/$|^/[A-Za-z0-9/_-]+$"
    }
  }
}
